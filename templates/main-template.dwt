<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>FunkyMonkey</title>
	<link rel="icon" href="images/Logo.png" type="image/png">
    <link href="css/bootstrap-4.4.1.css" rel="stylesheet">
    <link href="css/CustomStyle.css" rel="stylesheet" type="text/css">
	<!-- TemplateParam name="PageName" type="text" value="Home" -->
	<!-- TemplateParam name="FacebookURL" type="text" value="https://www.facebook.com/funkymonkeycoffeeco/?locale=en_GB" -->
	<!-- TemplateParam name="InstagramURL" type="text" value="https://www.instagram.com/funkymonkeycoffeeco/?hl=en" -->
	
</head>
<body>
<nav class="navbar navbar-expand-lg fixed-top">
  <div class="container-fluid"> 
        
      <div class="logo-group">
            <img src="images/Logo.png" alt="Funky Monkey Logo" class="nav-logo-large"/>
            
            <div class="brand-text-stack">
                <div class="brand-top-text">
                    <a class="navbar-brand brand-name" href="#">Funky Monkey&nbsp;</a>
                </div>
                
              <div class="brand-bottom-row">
                    <a href="@@(FacebookURL)@@" target="_blank" class="brand-sub-square">
                        <img src="images/Facebook.png" alt="Facebook Logo">
                    </a>
                    <a href="@@(InstagramURL)@@" target="_blank" class="brand-sub-square">
                        <img src="images/Instagram.png" alt="Instagram Logo">
                    </a>
              </div>
            </div>
      </div>
        
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navRes">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navRes">
            <ul class="navbar-nav ml-auto">
                <li class="nav-item"><a class="nav-link btn" href="javascript:void(0)" onclick="toggleAltDisplay()">Alt Text</a></li>
                <li class="nav-item"><a class="nav-link btn" href="index.html">Home</a></li>
                <li class="nav-item"><a class="nav-link btn" href="menu.html">Menu</a></li>
                <li class="nav-item"><a class="nav-link btn" href="events.html">Events</a></li>
                <li class="nav-item"><a class="nav-link btn" href="gallery.html">Gallery</a></li>
                <li class="nav-item"><a class="nav-link btn" href="vaccancies.html">Vaccancies</a></li>
            </ul>
        </div>
    </div>
</nav>

    <header class="page-header">
      <div class="container">
        <h1 class="display-4">@@(PageName)@@</h1>
      </div>
</header>
<!-- TemplateBeginEditable name="main-content" -->
    <main class="main-content"> </main>
<!-- TemplateEndEditable --><script src="../pages/js/jquery-3.4.1.min.js"></script>
<footer>
  <div class="row">
<div class="col-xl-3">
      <div class="card-footer col-md-4 col-xl-12 card-tall">
<div class="card-footer-body">
          <h5 class="card-footer-title">Opening Times</h5>
          <p class="card-footer-text">Mon-Fri 08:30 - 16:00</p>
          <p class="card-footer-text">Sat-Sun 09:00 - 16:00</p>
</div>
      </div>
    </div>
    <div class="col-xl-3">
      <div class="col-md-4 col-xl-12 card-tall card-footer">
        <div class="card-footer-body">
          <h5 class="card-footer-title">Contact Information</h5>
          <p class="card-footer-text">01614776044</p>
          <p class="card-footer-text">funkymonkeycc@outlook.com</p>
        </div>
      </div>
    </div>
    <div class="col-xl-6">
      <div class="col-md-4 col-xl-12 card-footer">
		<iframe width="100%" height="192px" frameborder="0" style="border:0" src="https://www.google.com/maps/embed/v1/place?key=AIzaSyB2NIWI3Tv9iDPrlnowr_0ZqZWoAQydKJU&q=Bramhall%20Lane%20Davenport%2C%20Bramhall%20Lane%2C%20Davenport%2C%20Stockport%20SK2%206JA%2C%20UK&maptype=roadmap" allowfullscreen></iframe>
      </div>
    </div>
</div>
</footer>
<script src="js/popper.min.js"></script>
    <script src="js/bootstrap-4.4.1.js"></script>
	<script src="js/ToggleAltDisplay.js"></script>
</body>
</html>